:root {
    --bg-transparent: rgba(0, 0, 0, 0);
    --error-text-color: rgb(224, 58, 58);
    --header-tint: rgb(190, 130, 130);
    --header-text-color: rgb(224, 224, 224);
}

.unity-light-theme {
    --error-text-color: rgb(180, 0, 0);
    --header-tint: rgb(140, 90, 90);
    --header-text-color: rgb(17, 17, 17);
}

