.modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.6);
    align-items: center;
    justify-content: center;
    -unity-picking-mode: position;
}

.modal-content {
    background-color: rgb(45, 45, 45);
    border-width: 1px;
    border-color: rgb(25, 25, 25);
    border-radius: 8px;
    padding: 20px;
    min-width: 350px;
    max-width: 500px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
}

.modal-header {
    -unity-font-style: bold;
    font-size: 16px;
    color: rgb(228, 228, 228);
    margin-bottom: 12px;
}

.modal-body-text {
    white-space: normal;
    color: rgb(189, 189, 189);
    margin-bottom: 24px;
    font-size: 13px;
    line-height: 18px;
}

.modal-footer {
    flex-direction: row;
    justify-content: flex-end;
}

.modal-button {
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 6px;
    padding-bottom: 6px;
    margin-left: 10px;
    border-radius: 4px;
}

.modal-button--confirm {
    background-color: rgb(53, 94, 59);
    color: white;
}

.modal-button--confirm:hover {
    background-color: rgb(69, 123, 77);
}

.modal-button--cancel {
    background-color: rgb(68, 68, 68);
}
