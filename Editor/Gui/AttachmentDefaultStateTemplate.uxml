<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="default-state-root" style="align-items: center; flex-direction: row; justify-content: flex-end; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; background-color: rgba(0, 0, 0, 0);">
        <ui:RadioButton />
        <ui:VisualElement style="flex-grow: 1;" />
        <ui:Label name="default-state-label" text="Default State: " style="width: 150px;" />
        <ui:Label name="bone-label" text="Bone: " style="width: 200px; display: none;" />
        <ui:Button name="detach-button" text="Detach" style="width: 100px; display: none;" />
        <ui:VisualElement name="attach-container" style="flex-direction: row; display: none;">
            <ui:VisualElement name="bone-popup-container" style="width: 100px;" />
            <ui:Button name="attach-button" text="Attach" style="width: 100px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
